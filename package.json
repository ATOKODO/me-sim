{
  "name": "me-sim",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "licenses:inventory": "node scripts/license-inventory.mjs",
    "licenses:check": "node scripts/license-inventory.mjs --check",
    "start": "ng serve --host 127.0.0.1 --port 1420",
    "build": "ng build",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "package": "tauri build --bundles nsis",
    "package:offline": "tauri build --bundles nsis --config src-tauri/tauri.offline.conf.json",
    "package:linux": "tauri build --bundles deb",
    "check:avatar": "node scripts/check-avatar.mjs",
    "test": "node scripts/test.mjs",
    "test:companion": "node --test companion/*.test.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "validate:local": "npm run test:dependencies && npm run licenses:check && npm run check:avatar && npm run test:companion && npm run docs:build && npm run test:local-preview && npm run build && npm run build:storybook && npm test && cargo test --locked --offline --manifest-path src-tauri/Cargo.toml && npm run test:visual -- --skip-build",
    "preview": "node scripts/serve.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"src/**/*.css\"",
    "storybook": "node scripts/storybook.mjs dev",
    "build:storybook": "node scripts/storybook.mjs build",
    "test:visual": "node scripts/test-visual.mjs",
    "test:visual:update": "node scripts/test-visual.mjs --update-snapshots",
    "test:visual:report": "playwright show-report playwright-report/visual",
    "docs:dev": "vitepress dev docs --host 127.0.0.1 --port 5174",
    "docs:build": "node scripts/check-docs.mjs && tsc -p tsconfig.docs.json && vitepress build docs",
    "docs:preview": "node scripts/serve-docs.mjs",
    "test:local-preview": "node --test scripts/local-preview.test.mjs",
    "test:dependencies": "node --test tests/dependencies/*.test.cjs",
    "check:dependencies": "npm audit --audit-level=low && npm run test:dependencies"
  },
  "dependencies": {
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/forms": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "@angular/router": "22.2.2",
    "@tauri-apps/api": "2.11.1",
    "rxjs": "7.8.2",
    "three": "0.186.0",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.2.2",
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.2",
    "@angular/platform-browser-dynamic": "22.2.2",
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.58.2",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/angular": "10.6.1",
    "@tauri-apps/cli": "2.11.4",
    "@types/three": "0.183.1",
    "prettier": "3.8.1",
    "storybook": "10.6.1",
    "typescript": "6.0.2",
    "vitepress": "1.6.4",
    "braces": "file:vendor/braces"
  },
  "overrides": {
    "vitepress": {
      "vite": "6.4.4"
    },
    "@storybook/builder-webpack5": {
      "webpack-dev-middleware": "7.4.6"
    },
    "braces": "$braces"
  }
}
