{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Me-Sim",
  "version": "0.1.0",
  "identifier": "fr.mesim.desktop",
  "build": {
    "beforeDevCommand": "npm start",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/me-sim/browser"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Me-Sim · Tes futurs possibles",
        "width": 1440,
        "height": 960,
        "minWidth": 960,
        "minHeight": 700,
        "backgroundColor": "#101419"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; frame-src 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Tes habitudes, tes futurs possibles. En local.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"],
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
